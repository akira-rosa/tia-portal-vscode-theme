    "gitDecoration.untrackedResourceForeground": "#5CC85C",
    "gitDecoration.deletedResourceForeground": "#FF5A5A",
    "gitDecoration.ignoredResourceForeground": "#93A7AD",
    "gitDecoration.conflictingResourceForeground": "#FF9900",
    "minimap.background": "#1E3038",
    "welcomePage.tileBackground": "#1A2B33",
    "walkThrough.embeddedEditorBackground": "#24383F",
    "keybindingLabel.background": "#22363F",
    "keybindingLabel.border": "#30474F"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7CC47F"
      }
    },
    {
      "name": "SCL pragmas / attributes",
      "scope": [
        "meta.attribute.scl",
        "meta.preprocessor",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8A9EA4"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#6CB2FF"
      }
    },
    {
      "name": "Declarations & block keywords",
      "scope": [
        "storage.type",
        "keyword.other.declaration.scl",
        "keyword.other.block.scl"
      ],
      "settings": {
        "foreground": "#6CB2FF"
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.word",
        "keyword.operator.logical.scl"
      ],
      "settings": {
        "foreground": "#6CB2FF"
      }
    },
    {
      "name": "Data types",
      "scope": [
        "storage.type.primitive",
        "support.type",
        "entity.name.type",
        "support.type.primitive.scl"
      ],
      "settings": {
        "foreground": "#6CB2FF"
      }
    },
    {
      "name": "Regions",
      "scope": [
        "keyword.control.region.scl"
      ],
      "settings": {
        "foreground": "#6CB2FF"
      }
    },
    {
      "name": "Symbol operators",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#C9D6D9"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#F0A27A"
      }
    },
    {
      "name": "Numbers & typed literals",
      "scope": [
        "constant.numeric",
        "constant.other.literal.scl"
      ],
      "settings": {
        "foreground": "#F2C072"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#6CB2FF"
      }
    },
    {
      "name": "Local tags (#Name)",
      "scope": [
        "variable.other.local.scl",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#4FD8CF"
      }
    },
    {
      "name": "Global tags (\"Name\")",
      "scope": [
        "variable.other.global.scl"
      ],
      "settings": {
        "foreground": "#E4ECEE"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E4ECEE"
      }
    },
    {
      "name": "Instructions / functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#D29BF0"
      }
    },
    {
      "name": "Classes / FB types",
      "scope": [
        "entity.name.class",
        "support.class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#D29BF0"
      }
    },
    {
      "name": "Tags / markup",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6CB2FF"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#4FD8CF"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#00B3B3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E4ECEE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#E4ECEE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#00B3B3"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF5A5A"
      }
    }
  ],
  "semanticTokenColors": {
    "variable.local": "#4FD8CF",
    "parameter": "#4FD8CF",
    "function": "#D29BF0",
    "method": "#D29BF0",
    "type": "#6CB2FF",
    "class": "#D29BF0",
    "keyword": "#6CB2FF",
    "comment": "#7CC47F",
    "string": "#F0A27A",
    "number": "#F2C072"
  }
}