    "editorSuggestWidget.highlightForeground": "#00B3B3",
    "editorHoverWidget.background": "#22363F",
    "editorHoverWidget.border": "#30474F",
    "peekView.border": "#00B3B3",
    "peekViewTitle.background": "#22363F",
    "peekViewEditor.background": "#24383F",
    "peekViewResult.background": "#1A2B33",
