  "tokenColors": [
    {
      "name": "Operands, numbers, literals, calls: plain black like TIA",
      "scope": [
        "source",
        "variable",
        "constant",
        "string",
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.other.local.scl",
        "variable.other.global.scl",
        "constant.numeric",
        "constant.other.literal.scl",
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "name": "Pragmas / attribute lists",
      "scope": [
        "meta.attribute.scl",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "name": "Keywords and data types",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "support.type",
        "keyword.operator.word",
        "keyword.operator.logical.scl",
        "constant.language"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "REGION lines (magenta)",
      "scope": [
        "keyword.control.region.scl",
        "entity.name.section.region.scl"
      ],
      "settings": {
        "foreground": "#C800FF"
      }
    },
    {
      "name": "Types / classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#2D354D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C800FF"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E00000"
      }
    }
  ]
}