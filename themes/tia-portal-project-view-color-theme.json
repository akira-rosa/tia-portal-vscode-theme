    "gitDecoration.untrackedResourceForeground": "#2E9E2E",
    "gitDecoration.deletedResourceForeground": "#E00000",
    "gitDecoration.ignoredResourceForeground": "#5A6266",
    "gitDecoration.conflictingResourceForeground": "#FF9900",
    "minimap.background": "#FFFFFF",
    "welcomePage.tileBackground": "#F0F0F0",
    "walkThrough.embeddedEditorBackground": "#F2F8F8",
    "keybindingLabel.background": "#D7DBDD",
    "keybindingLabel.border": "#B9BEC1"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "name": "SCL pragmas / attributes",
      "scope": [
        "meta.attribute.scl",
        "meta.preprocessor",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Declarations & block keywords",
      "scope": [
        "storage.type",
        "keyword.other.declaration.scl",
        "keyword.other.block.scl"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.word",
        "keyword.operator.logical.scl"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Data types",
      "scope": [
        "storage.type.primitive",
        "support.type",
        "entity.name.type",
        "support.type.primitive.scl"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Regions",
      "scope": [
        "keyword.control.region.scl"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Symbol operators",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#A31515"
      }
    },
    {
      "name": "Numbers & typed literals",
      "scope": [
        "constant.numeric",
        "constant.other.literal.scl"
      ],
      "settings": {
        "foreground": "#B35A00"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Local tags (#Name)",
      "scope": [
        "variable.other.local.scl",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#00646E"
      }
    },
    {
      "name": "Global tags (\"Name\")",
      "scope": [
        "variable.other.global.scl"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Instructions / functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#7A3E9D"
      }
    },
    {
      "name": "Classes / FB types",
      "scope": [
        "entity.name.class",
        "support.class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#7A3E9D"
      }
    },
    {
      "name": "Tags / markup",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#00646E"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#009999",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#00646E"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E00000"
      }
    }
  ],
  "semanticTokenColors": {
    "variable.local": "#00646E",
    "parameter": "#00646E",
    "function": "#7A3E9D",
    "method": "#7A3E9D",
    "type": "#0000FF",
    "class": "#7A3E9D",
    "keyword": "#0000FF",
    "comment": "#008000",
    "string": "#A31515",
    "number": "#B35A00"
  }
}