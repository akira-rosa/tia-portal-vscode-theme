    "editorGutter.addedBackground": "#2E9E2E",
    "editorGutter.modifiedBackground": "#009999",
    "editorGutter.deletedBackground": "#E00000",
    "editorOverviewRuler.border": "#B9BEC1",
    "editorWidget.background": "#F0F0F0",
    "editorWidget.border": "#B9BEC1",
    "editorSuggestWidget.background": "#FFFFFF",
    "editorSuggestWidget.border": "#B9BEC1",
    "editorSuggestWidget.selectedBackground": "#CCEBEB",
    "editorSuggestWidget.highlightForeground": "#009999",
    "editorHoverWidget.background": "#FFFFE1",
    "editorHoverWidget.border": "#B9BEC1",
    "peekView.border": "#009999",
    "peekViewTitle.background": "#D7DBDD",
    "peekViewEditor.background": "#F2F8F8",
    "peekViewResult.background": "#F0F0F0",
    "panel.background": "#FFFFFF",
    "panel.border": "#B9BEC1",
    "panelTitle.activeForeground": "#000000",
    "panelTitle.activeBorder": "#009999",
    "panelTitle.inactiveForeground": "#5A6266",
    "panelSectionHeader.background": "#D7DBDD",
    "terminal.background": "#FFFFFF",
    "terminal.foreground": "#000000",
    "terminalCursor.foreground": "#000000",
    "statusBar.background": "#D7DBDD",
    "statusBar.foreground": "#000000",
    "statusBar.border": "#B9BEC1",
    "statusBar.noFolderBackground": "#D7DBDD",
    "statusBar.debuggingBackground": "#FF9900",
    "statusBar.debuggingForeground": "#000000",
    "statusBar.debuggingBorder": "#FF9900",
    "statusBarItem.hoverBackground": "#CCEBEB",
    "statusBarItem.remoteBackground": "#009999",
    "statusBarItem.remoteForeground": "#FFFFFF",
    "statusBarItem.prominentBackground": "#009999",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "statusBarItem.errorBackground": "#E00000",
    "statusBarItem.warningBackground": "#E5A000",
    "debugToolBar.background": "#F0F0F0",
