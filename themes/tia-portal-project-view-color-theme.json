    "tab.inactiveForeground": "#5A6266",
    "tab.border": "#B9BEC1",
    "tab.hoverBackground": "#E5F4F4",
    "tab.unfocusedActiveBorderTop": "#B9BEC1",
    "tab.unfocusedActiveForeground": "#5A6266",
    "breadcrumb.background": "#FFFFFF",
